# Dedicated Telegram bot. Do not reuse an unrelated notification bot.
CODEX_REMOTE_BOT_TOKEN=
CODEX_REMOTE_ALLOWED_USER_IDS=

# alias=/absolute/path;another=/absolute/path
CODEX_REMOTE_REPOS=project=/absolute/path/to/project
CODEX_REMOTE_DEFAULT_REPO=project

CODEX_REMOTE_SANDBOX=workspace-write
CODEX_REMOTE_MODEL=
CODEX_REMOTE_TIMEOUT_SECONDS=1800
CODEX_REMOTE_CANCEL_GRACE_SECONDS=5
CODEX_REMOTE_POLL_TIMEOUT_SECONDS=25
CODEX_REMOTE_MAX_REPLY_CHARS=18000
CODEX_REMOTE_MAX_PROMPT_CHARS=12000
CODEX_REMOTE_RECENT_TASK_LIMIT=5
CODEX_REMOTE_REQUIRE_PRIVATE_CHAT=true
CODEX_REMOTE_EXTERNAL_ACTIVE_WINDOW_SECONDS=21600
CODEX_REMOTE_WATCH_POLL_SECONDS=20

# CODEX_REMOTE_CONFIG_DIR is read before this file loads and must be set in the
# process environment. Other optional values:
# CODEX_REMOTE_DATA_DIR=~/.local/state/codex-telegram-remote
# CODEX_REMOTE_CODEX_BIN=/opt/homebrew/bin/codex
# CODEX_REMOTE_CODEX_STATE_DB=~/.codex/state_5.sqlite
# CODEX_REMOTE_CODEX_THREAD_HISTORY_DB=~/.codex/thread_history_1.sqlite
# CODEX_REMOTE_REDACT_VALUES=secret-one,secret-two
